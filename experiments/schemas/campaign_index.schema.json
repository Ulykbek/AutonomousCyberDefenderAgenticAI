{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WP1 Campaign Index",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "campaign_id", "experiment_manifest",
    "experiment_manifest_hash", "agent_command", "created_at", "updated_at",
    "status", "max_workers_last_run", "cells"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "campaign_id": {"type": "string"},
    "experiment_manifest": {"type": "string"},
    "experiment_manifest_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "agent_command": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["planned", "running", "completed", "completed_with_failures"]},
    "max_workers_last_run": {"type": "integer", "minimum": 1},
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total_cells", "completed_cells", "incomplete_cells", "attempts"],
      "properties": {
        "total_cells": {"type": "integer", "minimum": 0},
        "completed_cells": {"type": "integer", "minimum": 0},
        "incomplete_cells": {"type": "integer", "minimum": 0},
        "attempts": {"type": "integer", "minimum": 0}
      }
    },
    "cells": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "cell_id", "condition_id", "incident_id", "instruction_profile",
          "repetition", "attempts"
        ],
        "properties": {
          "cell_id": {"type": "string"},
          "condition_id": {"type": "string"},
          "incident_id": {"type": "string"},
          "instruction_profile": {"type": "string"},
          "evidence_variant": {"type": "string"},
          "repetition": {"type": "integer", "minimum": 1},
          "attempts": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "attempt", "run_id", "run_directory", "started_at",
                "completed_at", "status", "failure_reason"
              ],
              "properties": {
                "attempt": {"type": "integer", "minimum": 1},
                "run_id": {"type": "string"},
                "run_directory": {"type": "string"},
                "started_at": {"type": "string", "format": "date-time"},
                "completed_at": {"type": ["string", "null"], "format": "date-time"},
                "status": {"enum": ["running", "completed", "failed", "timed_out", "invalid", "runner_error", "interrupted"]},
                "failure_reason": {"type": ["string", "null"]}
              }
            }
          }
        }
      }
    }
  }
}
