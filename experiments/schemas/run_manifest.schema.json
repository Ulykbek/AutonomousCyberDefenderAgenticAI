{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/wp1/run_manifest.schema.json",
  "title": "WP1 Run Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "experiment_id",
    "run_id",
    "condition_id",
    "baseline_id",
    "incident_id",
    "instruction_profile",
    "model",
    "evidence_hashes",
    "policy_hash",
    "instruction_hashes",
    "status"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "experiment_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "condition_id": {"type": "string", "minLength": 1},
    "baseline_id": {"type": "string", "minLength": 1},
    "incident_id": {"type": "string", "minLength": 1},
    "instruction_profile": {"type": "string", "minLength": 1},
    "model": {"type": "object", "additionalProperties": true},
    "seed": {"type": ["integer", "null"]},
    "started_at": {"type": ["string", "null"], "format": "date-time"},
    "completed_at": {"type": ["string", "null"], "format": "date-time"},
    "evidence_hashes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
    },
    "evidence_hashes_after": {
      "type": ["object", "null"],
      "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
    },
    "instruction_hashes": {
      "type": "object",
      "required": ["common", "profile", "composed"],
      "additionalProperties": false,
      "properties": {
        "common": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "profile": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "composed": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "policy_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "status": {"enum": ["planned", "running", "completed", "failed", "aborted", "timed_out", "invalid"]},
    "failure_reason": {"type": ["string", "null"]},
    "audit_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requests", "allowed", "denied", "executed"],
      "properties": {
        "requests": {"type": "integer", "minimum": 0},
        "allowed": {"type": "integer", "minimum": 0},
        "denied": {"type": "integer", "minimum": 0},
        "executed": {"type": "integer", "minimum": 0}
      }
    },
    "artifacts": {"type": "object", "additionalProperties": {"type": "string"}},
    "notes": {"type": "string"}
  }
}
