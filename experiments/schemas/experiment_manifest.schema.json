{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/wp1/experiment_manifest.schema.json",
  "title": "WP1 Experiment Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "experiment_id",
    "baseline_id",
    "title",
    "research_question",
    "conditions",
    "incident_ids",
    "instruction_profiles",
    "model",
    "repetitions"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "experiment_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "baseline_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "title": {"type": "string", "minLength": 1},
    "research_question": {"type": "string", "minLength": 1},
    "hypothesis": {"type": ["string", "null"]},
    "conditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["condition_id", "description"],
        "properties": {
          "condition_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
          "description": {"type": "string", "minLength": 1}
        }
      }
    },
    "incident_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "instruction_profiles": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "model": {
      "type": "object",
      "additionalProperties": true,
      "required": ["provider", "model_id"],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "model_id": {"type": "string", "minLength": 1}
      }
    },
    "repetitions": {"type": "integer", "minimum": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "notes": {"type": "string"}
  }
}
